{
  "env": {
    "CLAUDE_AFK_TIMEOUT_MS": "604800000"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "defaultMode": "default"
  },
  "model": "opus[1m]",
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "php-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "ticketmill@ticketmill": true,
    "attention-control@attention-control": true
  },
  "extraKnownMarketplaces": {
    "ticketmill": {
      "source": {
        "source": "github",
        "repo": "aaddrick/ticketmill"
      }
    },
    "attention-control": {
      "source": {
        "source": "github",
        "repo": "aaddrick/attention-control"
      }
    }
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto",
  "autoCompactEnabled": false,
  "agentPushNotifEnabled": true,
  "voiceEnabled": true
}
