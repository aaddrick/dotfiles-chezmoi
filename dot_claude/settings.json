{
  "env": {
    "CLAUDE_AFK_TIMEOUT_MS": "604800000",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "4",
    "CLAUDE_CODE_MAX_TOOL_USE_CONCURRENCY": "20",
    "CLAUDE_ASYNC_AGENT_STALL_TIMEOUT_MS": "1800000"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "opus",
  "skillOverrides": {
    "journal": "off",
    "writing-release-notes": "off"
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "php-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": false,
    "ticketmill@ticketmill": false,
    "attention-control@attention-control": true,
    "building-with-typesafe-jev@building-with-typesafe-jev": true
  },
  "extraKnownMarketplaces": {
    "ticketmill": {
      "source": {
        "source": "github",
        "repo": "aaddrick/ticketmill"
      }
    },
    "building-with-typesafe-jev": {
      "source": {
        "source": "github",
        "repo": "aaddrick/building-with-typesafe-jev"
      }
    },
    "scripting-blender-scenes": {
      "source": {
        "source": "directory",
        "path": "/home/aaddrick/source/scripting-blender-scenes"
      }
    }
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "medium"
    }
  },
  "pluginConfigs": {},
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto",
  "autoCompactEnabled": false,
  "agentPushNotifEnabled": true,
  "voiceEnabled": true
}
